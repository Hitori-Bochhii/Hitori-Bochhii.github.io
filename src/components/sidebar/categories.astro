---
import { getCategoryList } from "@utils/post";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import WidgetLayout from "./widgetLayout.astro";

const categories = await getCategoryList();

interface Props {
    class?: string;
    style?: string;
    side?: string;
}
const { class: className, style, side = "default" } = Astro.props;
---

<WidgetLayout
    name={i18n(I18nKey.categories)}
    id={`categories-${side}`}
    class={className}
    style={style}
>
    <ul class="flex flex-col gap-0.5">
        {categories.map((c) => (
            <li>
                <a
                    href={c.url}
                    aria-label={`查看 ${c.name} 分类下的所有文章`}
                    class="flex items-center justify-between px-2 py-1.5 rounded-md
                           hover:bg-(--primary)/8 transition-colors duration-200
                           group text-sm"
                >
                    <span class="text-neutral-700 dark:text-neutral-200 group-hover:text-(--primary) transition-colors font-medium">
                        {c.name}
                    </span>
                    <span class="inline-flex items-center justify-center min-w-[1.5rem] h-5 px-1.5
                                 text-xs rounded-full bg-neutral-200 dark:bg-neutral-700
                                 text-neutral-500 dark:text-neutral-400
                                 group-hover:bg-(--primary)/15 group-hover:text-(--primary)
                                 transition-colors font-medium tabular-nums">
                        {c.count}
                    </span>
                </a>
            </li>
        ))}
    </ul>
</WidgetLayout>
