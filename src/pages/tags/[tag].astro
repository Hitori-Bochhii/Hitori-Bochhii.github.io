---
import { getCollection } from "astro:content";
import { getPostUrl } from "@utils/url";
import { parseTags } from "@utils/tag";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";

export async function getStaticPaths() {
    const allPosts = await getCollection("posts", ({ data }) => {
        return import.meta.env.PROD ? data.draft !== true : true;
    });

    const tagSet = new Set<string>();
    for (const post of allPosts) {
        const tags = parseTags(post.data.tags);
        for (const tag of tags) {
            if (tag) tagSet.add(tag);
        }
    }

    return Array.from(tagSet).map((tag) => ({
        params: { tag },
    }));
}

const { tag } = Astro.params;

const allPosts = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
});

const filteredPosts = allPosts
    .filter((post) => {
        const tags = parseTags(post.data.tags);
        return tags.some((t) => t === tag);
    })
    .sort((a, b) => {
        const da = a.data.published || new Date(0);
        const db = b.data.published || new Date(0);
        return db.valueOf() - da.valueOf();
    });
---

<GridLayout title={`${i18n(I18nKey.tags)}: ${tag}`} description={`${filteredPosts.length} ${i18n(I18nKey.postsCount)}`}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <BackwardButton currentPath={Astro.url.pathname} />
            <header class="mb-8">
                <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
                    {i18n(I18nKey.tags)}: {tag}
                </h1>
                <p class="text-neutral-600 dark:text-neutral-400">
                    {filteredPosts.length} {i18n(I18nKey.postsCount)}
                </p>
            </header>

            {filteredPosts.length === 0 ? (
                <p class="text-neutral-500 dark:text-neutral-400 py-8 text-center">
                    {i18n(I18nKey.noTags)}
                </p>
            ) : (
                <ul class="flex flex-col gap-2">
                    {filteredPosts.map((post) => (
                        <li>
                            <a
                                href={getPostUrl(post)}
                                class="flex items-center justify-between px-3 py-2.5 rounded-lg
                                       hover:bg-(--primary)/6 transition-colors duration-200 group"
                            >
                                <span class="text-neutral-800 dark:text-neutral-100 font-medium
                                             group-hover:text-(--primary) transition-colors">
                                    {post.data.title}
                                </span>
                                <span class="text-xs text-neutral-400 dark:text-neutral-500 tabular-nums">
                                    {post.data.published instanceof Date
                                        ? post.data.published.toISOString().slice(0, 10)
                                        : String(post.data.published).slice(0, 10)}
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>
            )}
        </div>
    </div>
</GridLayout>
