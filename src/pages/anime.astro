---
export const prerender = true;

import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import { siteConfig } from "@/config";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import ImageWrapper from "@components/common/imageWrapper.astro";
import GridLayout from "@layouts/grid.astro";


const pageDescription = LinkPresets[LinkPreset.Anime].description;

const BANGUMI_USER_ID = siteConfig.bangumi?.userId || "";
const BANGUMI_API_BASE = "https://api.bgm.tv";

const isBangumiConfigured =
    BANGUMI_USER_ID &&
    BANGUMI_USER_ID !== "your-bangumi-id" &&
    BANGUMI_USER_ID !== "your-user-id";

async function fetchSubjectPersons(subjectId: number) {
    if (!isBangumiConfigured) return [];
    try {
        const response = await fetch(
            `${BANGUMI_API_BASE}/v0/subjects/${subjectId}/persons`,
        );
        const data = await response.json();
        return Array.isArray(data) ? data : [];
    } catch (error) {
        console.error(`Error fetching subject ${subjectId} persons:`, error);
        return [];
    }
}

async function fetchBangumiCollection(
    userId: string,
    subjectType: number,
    type: number,
) {
    if (!isBangumiConfigured) return null;
    try {
        let allData: any[] = [];
        let offset = 0;
        const limit = 50;
        let hasMore = true;

        while (hasMore) {
            const response = await fetch(
                `${BANGUMI_API_BASE}/v0/users/${userId}/collections?subject_type=${subjectType}&type=${type}&limit=${limit}&offset=${offset}`,
            );
            if (!response.ok) {
                throw new Error(`Bangumi API error: ${response.status}`);
            }
            const data = await response.json();

            if (data.data && data.data.length > 0) {
                allData = [...allData, ...data.data];
            }
            if (!data.data || data.data.length < limit) {
                hasMore = false;
            } else {
                offset += limit;
            }
            await new Promise((resolve) => setTimeout(resolve, 100));
        }
        return { data: allData };
    } catch (error) {
        console.error("Error fetching Bangumi data:", error);
        return null;
    }
}

async function processBangumiData(data: any, status: string) {
    if (!data || !data.data) return [];

    const detailedItems = await Promise.all(
        data.data.map(async (item: any) => {
            const subjectPersons = await fetchSubjectPersons(item.subject_id);
            const year = item.subject?.date || "Unknown";
            const rating = item.rate ? Number.parseFloat(item.rate.toFixed(1)) : 0;
            const progress = item.ep_status || 0;
            const totalEpisodes = item.subject?.eps || progress;

            let studio = "Unknown";
            if (Array.isArray(subjectPersons)) {
                const priorities = ["动画制作", "製作", "制作"];
                for (const relation of priorities) {
                    const match = subjectPersons.find(
                        (person) => person.relation === relation,
                    );
                    if (match?.name) {
                        studio = match.name;
                        break;
                    }
                }
            }

            return {
                title: item.subject?.name_cn || item.subject?.name || "Unknown Title",
                status: status,
                rating: rating,
                cover: item.subject?.images?.large || item.subject?.images?.medium || "/assets/anime/default.webp",
                description: (
                    item.subject?.short_summary ||
                    item.subject?.name_cn ||
                    ""
                ).trimStart(),
                year: year,
                genre: item.subject?.tags
                    ? item.subject.tags.slice(0, 3).map((tag: any) => tag.name)
                    : [],
                studio: studio,
                link: `https://bgm.tv/subject/${item.subject.id}` || "#",
                progress: progress,
                totalEpisodes: totalEpisodes,
            };
        }),
    );
    return detailedItems;
}

const watchingData = await fetchBangumiCollection(BANGUMI_USER_ID, 2, 3);
const completedData = await fetchBangumiCollection(BANGUMI_USER_ID, 2, 2);

const watchingList = watchingData
    ? await processBangumiData(watchingData, "watching")
    : [];
const completedList = completedData
    ? await processBangumiData(completedData, "completed")
    : [];

const animeList = [...completedList, ...watchingList];

function getStatusInfo(status: string) {
    switch (status) {
        case "watching":
            return {
                text: i18n(I18nKey.animeStatusWatching),
                class: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300",
            };
        case "completed":
            return {
                text: i18n(I18nKey.animeStatusCompleted),
                class: "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300",
            };
        default:
            return {
                text: status,
                class: "bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300",
            };
    }
}

const stats = {
    total: animeList.length,
    watching: animeList.filter((anime) => anime.status === "watching").length,
    completed: animeList.filter((anime) => anime.status === "completed").length,
    avgRating: (() => {
        const ratedAnime = animeList.filter((anime) => anime.rating > 0);
        if (ratedAnime.length === 0) return "N/A";
        return (
            ratedAnime.reduce((sum, anime) => sum + anime.rating, 0) /
            ratedAnime.length
        ).toFixed(1);
    })(),
};

const statCards = [
    { label: "Total", value: stats.total, color: "blue", icon: "material-symbols:collections-bookmark" },
    { label: "Watching", value: stats.watching, color: "emerald", icon: "material-symbols:play-circle" },
    { label: "Completed", value: stats.completed, color: "purple", icon: "material-symbols:check-circle" },
    { label: "Avg Rating", value: stats.avgRating, color: "amber", icon: "material-symbols:star" },
];
---

<GridLayout title="My Anime List" description={pageDescription}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">

            <!-- Back to Exhibition -->
            <a
                href="/exhibition/"
                class="inline-flex items-center gap-1.5 text-sm text-neutral-500 dark:text-neutral-400
                       hover:text-(--primary) transition-colors duration-200 mb-6 group"
            >
                <span class="text-lg leading-none transition-transform duration-200 group-hover:-translate-x-0.5">←</span>
                <span>Back to Exhibition</span>
            </a>

            <!-- Title Group -->
            <header class="mb-8">
                <h1 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-neutral-100 mb-2">
                    My Anime List
                </h1>
                <p class="text-neutral-500 dark:text-neutral-400 text-base">
                    A list of anime I have watched.
                </p>
            </header>

            <!-- Stats Cards -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10" id="stat-cards">
                <!-- Total -->
                <button
                    data-filter="all"
                    id="stat-total"
                    class="stat-card selected cursor-pointer
                           rounded-xl bg-blue-50 dark:bg-blue-900/20 p-4 flex items-center gap-3
                           border-2 border-transparent
                           hover:shadow-md transition-all duration-300
                           selected:ring-blue-400 selected:bg-blue-100 selected:dark:bg-blue-900/40
                           selected:border-blue-400 selected:shadow-md"
                >
                    <div class="w-10 h-10 rounded-lg bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center shrink-0">
                        <span class="text-blue-600 dark:text-blue-400 text-xl">📚</span>
                    </div>
                    <div class="text-left">
                        <div class="text-xl font-bold text-blue-700 dark:text-blue-300 tabular-nums">{stats.total}</div>
                        <div class="text-xs text-blue-500 dark:text-blue-400/80">Total</div>
                    </div>
                </button>
                <!-- Watching -->
                <button
                    data-filter="watching"
                    id="stat-watching"
                    class="stat-card cursor-pointer
                           rounded-xl bg-emerald-50 dark:bg-emerald-900/20 p-4 flex items-center gap-3
                           border-2 border-transparent
                           hover:shadow-md transition-all duration-300"
                >
                    <div class="w-10 h-10 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center shrink-0">
                        <span class="text-emerald-600 dark:text-emerald-400 text-xl">▶</span>
                    </div>
                    <div class="text-left">
                        <div class="text-xl font-bold text-emerald-700 dark:text-emerald-300 tabular-nums">{stats.watching}</div>
                        <div class="text-xs text-emerald-500 dark:text-emerald-400/80">Watching</div>
                    </div>
                </button>
                <!-- Completed -->
                <button
                    data-filter="completed"
                    id="stat-completed"
                    class="stat-card cursor-pointer
                           rounded-xl bg-purple-50 dark:bg-purple-900/20 p-4 flex items-center gap-3
                           border-2 border-transparent
                           hover:shadow-md transition-all duration-300"
                >
                    <div class="w-10 h-10 rounded-lg bg-purple-100 dark:bg-purple-900/40 flex items-center justify-center shrink-0">
                        <span class="text-purple-600 dark:text-purple-400 text-xl">✓</span>
                    </div>
                    <div class="text-left">
                        <div class="text-xl font-bold text-purple-700 dark:text-purple-300 tabular-nums">{stats.completed}</div>
                        <div class="text-xs text-purple-500 dark:text-purple-400/80">Completed</div>
                    </div>
                </button>
                <!-- Avg Rating -->
                <button
                    data-filter="rated"
                    id="stat-rated"
                    class="stat-card cursor-pointer
                           rounded-xl bg-amber-50 dark:bg-amber-900/20 p-4 flex items-center gap-3
                           border-2 border-transparent
                           hover:shadow-md transition-all duration-300"
                >
                    <div class="w-10 h-10 rounded-lg bg-amber-100 dark:bg-amber-900/40 flex items-center justify-center shrink-0">
                        <span class="text-amber-600 dark:text-amber-400 text-xl">★</span>
                    </div>
                    <div class="text-left">
                        <div class="text-xl font-bold text-amber-700 dark:text-amber-300 tabular-nums">{stats.avgRating}</div>
                        <div class="text-xs text-amber-500 dark:text-amber-400/80">Avg Rating</div>
                    </div>
                </button>
            </div>

            <!-- Anime Grid -->
            {!isBangumiConfigured ? (
                <div class="text-center py-16">
                    <div class="text-5xl mb-4">😢</div>
                    <h3 class="text-xl font-medium text-neutral-800 dark:text-neutral-200 mb-2">
                        {i18n(I18nKey.animeEmpty)}
                    </h3>
                    <p class="text-neutral-500 dark:text-neutral-400">
                        Please configure your Bangumi account in the config file.
                    </p>
                </div>
            ) : animeList.length > 0 ? (
                <div
                    id="anime-scroll-container"
                    class="overflow-y-auto max-h-[75vh] overscroll-contain
                           scrollbar-thin scrollbar-thumb-rounded
                           pr-1"
                >
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
                    {animeList.map(anime => {
                        const statusInfo = getStatusInfo(anime.status);
                        return (
                            <a
                                href={anime.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                data-filter-status={anime.status}
                                data-rating={anime.rating}
                                class="anime-card group block bg-white dark:bg-neutral-800/50
                                       rounded-2xl overflow-hidden border border-neutral-200
                                       dark:border-neutral-700/50
                                       hover:shadow-xl hover:-translate-y-1
                                       transition-all duration-300 ease-out"
                            >
                                <!-- Poster Section -->
                                <div class="relative aspect-[3/4] overflow-hidden bg-neutral-100 dark:bg-neutral-800">
                                    <ImageWrapper
                                        src={anime.cover}
                                        alt={anime.title}
                                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                        loading="lazy"
                                    />
                                    <!-- Top-left: Status Badge -->
                                    <div class={`absolute top-3 left-3 px-2.5 py-1 rounded-lg text-xs font-semibold ${statusInfo.class}`}>
                                        {statusInfo.text}
                                    </div>
                                    <!-- Top-right: Rating Badge -->
                                    {anime.rating > 0 && (
                                        <div class="absolute top-3 right-3 bg-black/65 backdrop-blur-sm text-white
                                                    px-2 py-1 rounded-lg text-xs font-semibold flex items-center gap-1">
                                            <svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                            </svg>
                                            <span class="tabular-nums">{anime.rating}</span>
                                        </div>
                                    )}
                                </div>

                                <!-- Info Section -->
                                <div class="p-4">
                                    <h3 class="font-bold text-neutral-900 dark:text-neutral-100 text-sm
                                               line-clamp-1 mb-1.5 group-hover:text-(--primary) transition-colors">
                                        {anime.title}
                                    </h3>
                                    <p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2 mb-3 leading-relaxed">
                                        {anime.description}
                                    </p>

                                    <!-- Metadata -->
                                    <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs mb-3">
                                        <span class="text-neutral-400 dark:text-neutral-500">Year: <span class="text-neutral-600 dark:text-neutral-300 font-medium">{anime.year}</span></span>
                                        <span class="text-neutral-400 dark:text-neutral-500">Studio: <span class="text-neutral-600 dark:text-neutral-300 font-medium">{anime.studio}</span></span>
                                    </div>

                                    <!-- Genre Tags -->
                                    <div class="flex flex-wrap gap-1.5">
                                        {anime.genre.map(g => (
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-medium
                                                         bg-pink-100 text-pink-700 dark:bg-pink-900/30 dark:text-pink-300">
                                                {g}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            </a>
                        );
                    })}
                </div>
                </div>
            ) : (
                <div class="text-center py-16">
                    <div class="text-5xl mb-4">😢</div>
                    <h3 class="text-xl font-medium text-neutral-800 dark:text-neutral-200 mb-2">
                        {i18n(I18nKey.animeEmpty)}
                    </h3>
                    <p class="text-neutral-500 dark:text-neutral-400">
                        {i18n(I18nKey.animeEmptyBangumi)}
                    </p>
                </div>
            )}
        </div>
    </div>
</GridLayout>

<style is:inline>
    /* Custom scrollbar for anime list */
    #anime-scroll-container {
        scrollbar-width: thin;
        scrollbar-color: transparent transparent;
        transition: scrollbar-color 0.3s ease;
    }

    #anime-scroll-container:hover,
    #anime-scroll-container:active,
    #anime-scroll-container.scrolling {
        scrollbar-color: var(--primary) transparent;
    }

    #anime-scroll-container::-webkit-scrollbar {
        width: 5px;
    }

    #anime-scroll-container::-webkit-scrollbar-track {
        background: transparent;
        border-radius: 10px;
    }

    #anime-scroll-container::-webkit-scrollbar-thumb {
        background: transparent;
        border-radius: 10px;
        transition: background 0.3s ease;
        min-height: 40px;
    }

    #anime-scroll-container:hover::-webkit-scrollbar-thumb,
    #anime-scroll-container.scrolling::-webkit-scrollbar-thumb {
        background: rgba(148, 163, 184, 0.35);
    }

    #anime-scroll-container::-webkit-scrollbar-thumb:hover {
        background: rgba(148, 163, 184, 0.55);
    }

    :root.dark #anime-scroll-container:hover::-webkit-scrollbar-thumb,
    :root.dark #anime-scroll-container.scrolling::-webkit-scrollbar-thumb {
        background: rgba(148, 163, 184, 0.30);
    }

    :root.dark #anime-scroll-container::-webkit-scrollbar-thumb:hover {
        background: rgba(148, 163, 184, 0.50);
    }
</style>

<script>
    function initAnimeFilter() {
        var statCards = document.querySelectorAll('.stat-card');
        var scrollContainer = document.getElementById('anime-scroll-container');
        var animeCards = document.querySelectorAll('.anime-card');

        if (statCards.length === 0 || animeCards.length === 0) {
            console.log('[AnimeFilter] SKIP: statCards=' + statCards.length + ' animeCards=' + animeCards.length);
            return;
        }
        console.log('[AnimeFilter] READY: statCards=' + statCards.length + ' animeCards=' + animeCards.length);

        var selectedStyles = {
            all: 'border-blue-400 bg-blue-100 dark:bg-blue-900/40 shadow-md',
            watching: 'border-emerald-400 bg-emerald-100 dark:bg-emerald-900/40 shadow-md',
            completed: 'border-purple-400 bg-purple-100 dark:bg-purple-900/40 shadow-md',
            rated: 'border-amber-400 bg-amber-100 dark:bg-amber-900/40 shadow-md',
        };

        function applySelected(card) {
            statCards.forEach(function(c) {
                c.classList.remove('selected', 'shadow-md');
                Object.values(selectedStyles).forEach(function(s) {
                    s.split(' ').forEach(function(cls) { c.classList.remove(cls); });
                });
            });
            var filter = card.dataset.filter;
            if (filter && selectedStyles[filter]) {
                card.classList.add('selected');
                selectedStyles[filter].split(' ').forEach(function(cls) { card.classList.add(cls); });
            }
            console.log('[AnimeFilter] selected: ' + filter);
        }

        function filterAnime(filter) {
            if (scrollContainer) {
                scrollContainer.scrollTo({ top: 0, behavior: 'auto' });
            }

            var cards = document.querySelectorAll('.anime-card');
            console.log('[AnimeFilter] filter=' + filter + ' total=' + cards.length);

            var visibleCount = 0;
            cards.forEach(function(card, index) {
                var status = card.dataset.filterStatus;
                var rating = parseFloat(card.dataset.rating || '0');

                var shouldShow = false;
                if (filter === 'all') {
                    shouldShow = true;
                } else if (filter === 'rated') {
                    shouldShow = rating > 0;
                } else {
                    shouldShow = status === filter;
                }

                if (shouldShow) {
                    visibleCount++;
                    card.style.display = '';
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.95)';
                    (function(c, i) {
                        requestAnimationFrame(function() {
                            setTimeout(function() {
                                c.style.transition = 'opacity 0.35s ease-out, transform 0.35s ease-out';
                                c.style.opacity = '1';
                                c.style.transform = '';
                            }, 10 + Math.floor(i / 4) * 40);
                        });
                    })(card, index);
                } else {
                    card.style.transition = 'opacity 0.2s ease-out';
                    card.style.opacity = '0';
                    (function(c) {
                        setTimeout(function() {
                            if (c.style.opacity === '0') {
                                c.style.display = 'none';
                            }
                        }, 200);
                    })(card);
                }
            });
            console.log('[AnimeFilter] visible: ' + visibleCount);
        }

        statCards.forEach(function(card) {
            card.addEventListener('click', function() {
                var filter = card.dataset.filter;
                if (!filter) return;
                console.log('[AnimeFilter] click: ' + filter);
                applySelected(card);
                filterAnime(filter);
            });
        });

        if (scrollContainer) {
            var scrollTimeout;
            scrollContainer.addEventListener('scroll', function() {
                scrollContainer.classList.add('scrolling');
                clearTimeout(scrollTimeout);
                scrollTimeout = setTimeout(function() {
                    scrollContainer.classList.remove('scrolling');
                }, 1000);
            }, { passive: true });
        }

        // Default: Total selected
        var totalCard = document.getElementById('stat-total');
        if (totalCard) {
            applySelected(totalCard);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAnimeFilter);
    } else {
        initAnimeFilter();
    }

    document.addEventListener('swup:contentReplaced', initAnimeFilter);
</script>
